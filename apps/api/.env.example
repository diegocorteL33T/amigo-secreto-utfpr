# Variáveis da API (apps/api). Modelo sem valores reais.
# Localmente nenhuma é obrigatória. Em produção, elas ficam na Vercel.

# Chave que lacra os links de revelação. Mínimo de 16 caracteres.
# Obrigatória em produção: sem ela, a API não sobe.
SORTEIO_SECRET=

# Porta da API. Padrão: 3001.
PORT=3001
