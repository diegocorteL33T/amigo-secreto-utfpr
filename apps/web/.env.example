# Variáveis do site (apps/web). Modelo sem valores reais.
# Para usar localmente, copie para apps/web/.env.local (o Next.js lê sozinho).
# Em produção, ela fica na Vercel.

# Endereço da API. O Next.js repassa as chamadas de /api/... para ele.
# Padrão: http://localhost:3001
API_URL=http://localhost:3001

# Endereço público do site, usado na prévia do link (og:image e og:url).
# Opcional. Padrão: VERCEL_PROJECT_PRODUCTION_URL na Vercel; fora dela,
# http://localhost:3000. Em produção, a pipeline passa este valor no build.
# SITE_URL=http://localhost:3000
